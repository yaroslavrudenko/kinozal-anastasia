<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets" xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://yaroslav.local/ottclubplayer" version="1.9.4" viewmodes="maximized">
    <tizen:application id="Yr0ttPlay1.OttClubPlayer" package="Yr0ttPlay1" required_version="2.3"/>
    <name>Настин кинозал</name>
    <icon src="img/icon.png"/>
    <content src="index.html"/>
    <access origin="*" subdomains="true"/>
    <tizen:allow-navigation>*</tizen:allow-navigation>
    <tizen:content-security-policy>default-src * 'unsafe-inline' 'unsafe-eval' data: blob:</tizen:content-security-policy>
    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <!-- «О программе» → «Автор» → OK opens the author's LinkedIn profile in the TV's browser -->
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>
    <tizen:profile name="tv-samsung"/>
    <!-- Plays on behind our Home Dashboard (js/remote-control.js 'play-behind'); every other app still stops it (js/playback.js).
         background-support="enable" (tizen:setting below) keeps the hidden app's scripts running so the dashboard's message arrives;
         background-category "media" (Tizen web config, since 2.4) declares the reason: playing audio/video in the background.
         Unverified on the UE50MU7000 (Tizen 3.0) until the owner's TV run. -->
    <tizen:background-category value="media"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="enable"
                   encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
